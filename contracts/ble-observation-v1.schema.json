{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinshasha/bluewatch-ble-bridge/contracts/ble-observation-v1.schema.json",
  "title": "BlueWatch BLE Observation Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_id", "batch_id", "sent_at", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "producer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "batch_id": {"type": "string", "format": "uuid"},
    "sent_at": {"type": "string", "format": "date-time"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "binaryMap": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "contentEncoding": "base64"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "name",
        "rssi",
        "observed_at",
        "source",
        "connectable",
        "service_uuids",
        "manufacturer_data",
        "service_data",
        "appearance"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
        },
        "name": {"type": ["string", "null"], "maxLength": 248},
        "rssi": {"type": "integer", "minimum": -127, "maximum": 20},
        "observed_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "connectable": {"type": "boolean"},
        "service_uuids": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "format": "uuid"}
        },
        "manufacturer_data": {"$ref": "#/$defs/binaryMap"},
        "service_data": {"$ref": "#/$defs/binaryMap"},
        "appearance": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 65535
        }
      }
    }
  }
}
